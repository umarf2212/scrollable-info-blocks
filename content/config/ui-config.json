      "text": "#171A18",
      "muted": "#68706B",
      "border": "rgba(23, 26, 24, 0.12)"
    },
    "dark": {
      "background": "#0D100E",
      "surface": "rgba(24, 28, 25, 0.78)",
      "surfaceStrong": "#181C19",
      "text": "#F4F2EC",
      "muted": "#9DA59F",
      "border": "rgba(244, 242, 236, 0.13)"
